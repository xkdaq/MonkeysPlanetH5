# H5 与后端同域部署时留空即可。
# 独立域名部署时填写后端域名，例如：https://api.monkeysxu.top
VITE_API_BASE=https://api.monkeysxu.top

# 页面展示的公众号名称。
VITE_OFFICIAL_ACCOUNT_NAME=猴哥考研

# 是否显示“资料领取”模块。设置为 false / 0 / off / no 时，只显示学习笔记模块。
VITE_MATERIAL_ENABLED=true

# 本地 npm run dev 代理到哪个后端。
# 如果你的后端跑在 8080，就改成 http://localhost:8080
# http://localhost
VITE_PROXY_TARGET=https://api.monkeysxu.top
